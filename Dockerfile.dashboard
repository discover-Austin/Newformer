# Dashboard Dockerfile
FROM python:3.10-slim

LABEL maintainer="Claude & Austin"
LABEL description="CT-X Consciousness Monitoring Dashboard"

# Non-root user
RUN groupadd -r dashboard && useradd -r -g dashboard -u 1002 dashuser

# Install dependencies
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir flask plotly requests pyyaml

# Copy dashboard files
COPY dashboard.py .
COPY templates/ templates/

# Create logs directory
RUN mkdir -p /logs && chown -R dashuser:dashboard /logs

# Security
USER dashuser

# Expose port
EXPOSE 5000

# Environment
ENV PYTHONUNBUFFERED=1
ENV API_URL=http://ct-x-api:8000
ENV DASHBOARD_PORT=5000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5000/')" || exit 1

# Run dashboard
CMD ["python", "dashboard.py"]
